<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NexPic" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="colorSurface">#FBFCFF</item>
        <item name="android:colorBackground">#FBFCFF</item>
        <item name="colorOnSurface">#1A1C1E</item>
        <item name="colorSurfaceVariant">#E1E2EC</item>
        <item name="colorOnSurfaceVariant">#44474F</item>
        <item name="colorOutline">#74777F</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#F3F4F9</item>
        <item name="colorSurfaceContainer">#EDEEF3</item>
        <item name="colorSurfaceContainerHigh">#E7E8EE</item>
        <item name="colorSurfaceContainerHighest">#E1E2E8</item>
    </style>

    <!-- Tema "Biru": biru modern pekat, bilah atas biru. Dipilih di Pengaturan > Tema. -->
    <style name="ThemeOverlay.NexPic.BlueMode" parent="">
        <item name="colorPrimary">#1D63ED</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#B6CEFF</item>
        <item name="colorOnPrimaryContainer">#001A4D</item>
        <item name="colorSecondary">#1D63ED</item>
        <item name="colorSecondaryContainer">#C3D6FF</item>
        <item name="colorOnSecondaryContainer">#0A1F52</item>
        <item name="colorSurface">#F9FBFF</item>
        <item name="android:colorBackground">#F9FBFF</item>
        <item name="colorSurfaceContainerLow">#EFF4FF</item>
        <item name="colorSurfaceContainer">#E7EEFF</item>
        <item name="colorSurfaceContainerHigh">#DEE8FF</item>
        <item name="colorSurfaceContainerHighest">#D5E1FB</item>
    </style>

    <style name="Theme.NexPic.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.NexPic</item>
    </style>

    <style name="ThemeOverlay.NexPic.Amoled" parent="">
        <item name="colorSurface">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#050505</item>
        <item name="colorSurfaceContainer">#0B0B0B</item>
        <item name="colorSurfaceContainerHigh">#141414</item>
        <item name="colorSurfaceContainerHighest">#1C1C1C</item>
        <item name="colorSurfaceDim">#000000</item>
    </style>
</resources>
